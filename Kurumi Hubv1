-- Анимация падения K
local function PlayLoadingAnimation()
    local TweenService = game:GetService("TweenService")
    
    -- Падение буквы K
    local FallTween = TweenService:Create(LetterK, TweenInfo.new(
        0.8,
        Enum.EasingStyle.Quad,
        Enum.EasingDirection.Out
    ), {
        Position = UDim2.new(0, 0, 0, 0)
    })
    
    -- Появление остального текста
    local RestTextAppear = TweenService:Create(RestText, TweenInfo.new(
        0.5,
        Enum.EasingStyle.Quad,
        Enum.EasingDirection.Out
    ), {
        TextTransparency = 0
    })
    
    -- Появление Welcome Bro :)
    local WelcomeAppear = TweenService:Create(WelcomeText, TweenInfo.new(
        0.8,
        Enum.EasingStyle.Quad,
        Enum.EasingDirection.Out
    ), {
        TextTransparency = 0
    })
    
    -- Анимация прогресс-бара
    local ProgressTween = TweenService:Create(ProgressBar, TweenInfo.new(
        3,
        Enum.EasingStyle.Linear,
        Enum.EasingDirection.Out
    ), {
        Size = UDim2.new(1, 0, 1, 0)
    })
    
    -- Запускаем анимацию падения
    FallTween:Play()
    ProgressTween:Play()
    
    -- Ждем падения
    task.wait(0.8)
    
    -- Показываем "urumi Hub"
    RestTextAppear:Play()
    
    -- Показываем Welcome Bro :)
    task.wait(0.8)
    WelcomeAppear:Play()
    
    -- Ждем завершения анимации
    task.wait(2)
    
    -- Плавно скрываем загрузочный экран
    local FadeOut = TweenService:Create(LoadingGui, TweenInfo.new(
        0.5,
        Enum.EasingStyle.Quad,
        Enum.EasingDirection.Out
    ), {
        Enabled = false
    })
    
    FadeOut:Play()
    FadeOut.Completed:Wait()
    LoadingGui:Destroy()
    
    -- Создаем основной UI
    CreateMainUI()
end

